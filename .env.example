# Local LLM (Ollama or OpenAI-compatible on GB10)
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2
# Thinking models (gpt-oss) need headroom: reasoning tokens count toward max tokens
# LOCAL_LLM_THINK=low
# LOCAL_LLM_MAX_TOKENS=600
# LOCAL_LLM_TIMEOUT_MS=45000
# LOCAL_OPENAI_COMPAT_URL=http://127.0.0.1:8000/v1

# Discord (OpenClaw / bot) — never commit real secrets
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
